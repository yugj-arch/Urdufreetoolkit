# Copy to .env for local dev (git-ignored). On Vercel, set these as the
# project's Environment Variables instead — the Settings panel is read-only there.
#
# Every key is optional: a provider with no key just shows as "needs key" and the
# rest of the app works. Pick the engines you actually want to demo.

# --- OCR / transliteration (cloud engines) ---
OPENAI_API_KEY=            # GPT vision OCR + transliteration  (platform.openai.com)
ANTHROPIC_API_KEY=         # Claude vision OCR                 (console.anthropic.com)
GOOGLE_API_KEY=            # Gemini OCR, free tier             (aistudio.google.com)
GOOGLE_VISION_KEY=         # Google Cloud Vision OCR           (GCP → Vision API key)
GROQ_API_KEY=              # Groq Llama transliteration, free  (console.groq.com)

# --- optional model overrides (sane defaults if unset) ---
OPENAI_MODEL=
ANTHROPIC_MODEL=
GEMINI_MODEL=
GROQ_MODEL=

# --- other keys the Settings panel knows about (no provider wired yet) ---
# OCRSPACE_API_KEY=
# AZURE_VISION_KEY=
# AZURE_VISION_ENDPOINT=
# HF_TROCR_CKPT=
