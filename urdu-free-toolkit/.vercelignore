# Keep the full local dependency set out of the serverless build.
# Vercel installs from api/requirements.txt instead (cloud engines only).
# Anchored to the project root so api/requirements.txt is NOT matched.
/requirements.txt

# Not needed at runtime on the deployed site
tests/
training/
eval/
pytest.ini
.pytest_cache/
__pycache__/

# Local-only checkpoints (git ignores them too) -- keeps a `vercel` CLI deploy
# under the function size limit. Rekhta Labs' models are fetched at runtime.
/data/rekhta_models/
/data/rekhta_model/*
!/data/rekhta_model/model.pt
/data/translit_model/model_*.pt

# Never ship secrets; the example stays
.env
.env.*
!.env.example
